# Connessione al database
DATABASE_URL="postgresql://utente:password@localhost:5432/piano_offerte?schema=public"

# Fuso di riferimento della pianificazione
TZ="Europe/Rome"

# Autenticazione: "sviluppo" mostra la scelta dell'utenza, "easyauth" legge
# l'identita dalle intestazioni iniettate da Azure App Service o Container Apps
# collegati a Microsoft Entra ID. Qualunque altro valore vale "sviluppo".
MODALITA_AUTENTICAZIONE="sviluppo"

# La modalita sviluppo NON e una autenticazione: chiunque puo scegliere
# qualunque identita. Per questo in produzione viene rifiutata. Questo consenso
# esplicito la riabilita, e serve solo per provare una compilazione di
# produzione in locale o nell'integrazione continua.
CONSENTI_ACCESSO_SVILUPPO=""

# Notifiche: "registro" scrive nel log del server, "graph" spedisce posta
# tramite Microsoft Graph. Con "graph" le quattro variabili sotto sono tutte
# obbligatorie, altrimenti l'avvio delle notifiche fallisce dicendo quale manca.
CANALE_NOTIFICHE="registro"
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
GRAPH_MITTENTE=""

# Chiave condivisa che protegge l'invio del digest giornaliero. Senza, la rotta
# resta chiusa: un endpoint che spedisce posta a tutta la divisione non deve
# essere aperto per dimenticanza.
CHIAVE_NOTIFICHE=""
